soong_namespace {
}

cc_binary {
    name: "bixi-cover-display-cleanup",
    recovery: true,
    srcs: ["display/bixi_cover_display_cleanup.c"],
    c_std: "gnu11",
    static_libs: ["libdrm"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

// Keep the stock vibrator HAL's persistent debug stream on tmpfs and load its
// haptics library from the recovery ramdisk, so neither /data nor /odm is
// pinned by the running service.
cc_library_shared {
    name: "libbixi_haptic_log_redirect",
    recovery: true,
    srcs: ["haptics/haptic_log_redirect.c"],
    compile_multilib: "64",
    shared_libs: ["libdl"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}
